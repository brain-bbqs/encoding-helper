{
  "name": "encoding-helper",
  "version": "0.1.0",
  "description": "A didactic, in-browser video encoding lab: inspect MP4/H.264 structure, learn how encoding works, run empirical seeking tests, and re-encode video directly in the browser.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite --config configs/vite.config.ts",
    "build": "tsc --noEmit && vite build --config configs/vite.config.ts",
    "preview": "vite preview --config configs/vite.config.ts",
    "test": "vitest run --config configs/vitest.config.ts",
    "test:watch": "vitest --config configs/vitest.config.ts",
    "test:coverage": "vitest run --coverage --config configs/vitest.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --config configs/eslint.config.cjs ."
  },
  "dependencies": {
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "mediabunny": "^1.50.8",
    "mp4box": "^0.5.2"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "^22.9.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "9.39.5",
    "jsdom": "^25.0.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "8.64.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}

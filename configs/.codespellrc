[codespell]
skip = package-lock.json,*.svg,*.png,*.jpg,*.jpeg,*.gif,*.ico,*.mp4,dist,node_modules
# "reencode" is the app's own word (the "Reencode with FFmpeg" tab), not a typo for
# "re-encode"; "ans" is a real variable name (binary search accumulator), not "and";
# "nam" is the QuickTime title atom (©nam), one of several four-character tag names the
# metadata knowledge base quotes verbatim.
ignore-words-list = reencode,ans,nam
